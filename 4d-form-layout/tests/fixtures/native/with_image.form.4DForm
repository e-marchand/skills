{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"destination": "detailScreen",
	"windowTitle": "AI Harness With Image",
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onClick"
	],
	"pages": [
		{
			"objects": {
				"FixtureImage": {
					"type": "picture",
					"top": 20,
					"left": 20,
					"width": 64,
					"height": 64,
					"picture": "Images/fixture.png"
				},
				"CaptionText": {
					"type": "text",
					"top": 24,
					"left": 100,
					"width": 220,
					"height": 24,
					"text": "Image-backed fixture",
					"fontSize": 18
				},
				"DetailText": {
					"type": "text",
					"top": 58,
					"left": 100,
					"width": 240,
					"height": 20,
					"text": "Uses a relative picture path"
				},
				"PreviewButton": {
					"type": "button",
					"top": 102,
					"left": 20,
					"width": 170,
					"height": 30,
					"text": "Native preview"
				}
			}
		}
	]
}
