{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowTitle": "LayoutProject Settings",
	"destination": "detailScreen",
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 760,
	"windowMinHeight": 680,
	"windowMaxWidth": 760,
	"windowMaxHeight": 680,
	"rightMargin": 20,
	"bottomMargin": 20,
	"width": 760,
	"height": 680,
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"settingsTitle": {
					"type": "text",
					"top": 28,
					"left": 190,
					"width": 380,
					"height": 34,
					"text": "LayoutProject Settings",
					"fontSize": 24,
					"fontWeight": "bold",
					"textAlign": "center"
				},
				"versionLabel": {
					"type": "text",
					"top": 96,
					"left": 178,
					"width": 404,
					"height": 32,
					"text": "macOS Version  2.2.1",
					"fontSize": 22,
					"fontWeight": "bold",
					"textAlign": "center"
				},
				"dividerOne": {
					"type": "line",
					"top": 148,
					"left": 338,
					"width": 270,
					"height": 0,
					"startPoint": "topLeft",
					"stroke": "#dddddd",
					"strokeWidth": 1
				},
				"colorSchemeLabel": {
					"type": "text",
					"top": 184,
					"left": 136,
					"width": 186,
					"height": 28,
					"text": "Color Scheme",
					"fontSize": 16,
					"textAlign": "right"
				},
				"radioDefaultSystem": {
					"type": "radio",
					"top": 184,
					"left": 336,
					"width": 250,
					"height": 24,
					"text": "Default System",
					"radioGroup": "colorSchemeGroup",
					"textPlacement": "right",
					"fontSize": 16,
					"dataSource": "Form.colorScheme",
					"dataSourceTypeHint": "integer"
				},
				"radioLight": {
					"type": "radio",
					"top": 222,
					"left": 336,
					"width": 180,
					"height": 24,
					"text": "Light",
					"radioGroup": "colorSchemeGroup",
					"textPlacement": "right",
					"fontSize": 16,
					"dataSource": "Form.colorScheme",
					"dataSourceTypeHint": "integer"
				},
				"radioDark": {
					"type": "radio",
					"top": 260,
					"left": 336,
					"width": 180,
					"height": 24,
					"text": "Dark",
					"radioGroup": "colorSchemeGroup",
					"textPlacement": "right",
					"fontSize": 16,
					"dataSource": "Form.colorScheme",
					"dataSourceTypeHint": "integer"
				},
				"dividerTwo": {
					"type": "line",
					"top": 300,
					"left": 338,
					"width": 270,
					"height": 0,
					"startPoint": "topLeft",
					"stroke": "#dddddd",
					"strokeWidth": 1
				},
				"menuBarLabel": {
					"type": "text",
					"top": 334,
					"left": 112,
					"width": 210,
					"height": 28,
					"text": "Menu Bar Extra",
					"fontSize": 16,
					"textAlign": "right"
				},
				"menuBarExtraCheckbox": {
					"type": "checkbox",
					"top": 334,
					"left": 336,
					"width": 290,
					"height": 24,
					"text": "Show menu bar extra",
					"textPlacement": "right",
					"fontSize": 16,
					"dataSource": "Form.showMenuBarExtra",
					"dataSourceTypeHint": "boolean"
				},
				"dividerThree": {
					"type": "line",
					"top": 408,
					"left": 338,
					"width": 270,
					"height": 0,
					"startPoint": "topLeft",
					"stroke": "#dddddd",
					"strokeWidth": 1
				},
				"fontLabel": {
					"type": "text",
					"top": 444,
					"left": 236,
					"width": 86,
					"height": 28,
					"text": "Font",
					"fontSize": 16,
					"textAlign": "right"
				},
				"fontDescription": {
					"type": "text",
					"top": 444,
					"left": 336,
					"width": 280,
					"height": 28,
					"text": "Used for all new messages",
					"fontSize": 16
				},
				"pointSizeLabel": {
					"type": "text",
					"top": 492,
					"left": 170,
					"width": 152,
					"height": 28,
					"text": "Point Size 15",
					"fontSize": 16,
					"textAlign": "right"
				},
				"pointSizeRuler": {
					"type": "ruler",
					"top": 494,
					"left": 338,
					"width": 270,
					"height": 24,
					"dataSource": "Form.pointSize",
					"dataSourceTypeHint": "integer",
					"min": 8,
					"max": 36,
					"step": 1,
					"showGraduations": true,
					"graduationStep": 1
				},
				"dividerFour": {
					"type": "line",
					"top": 566,
					"left": 338,
					"width": 270,
					"height": 0,
					"startPoint": "topLeft",
					"stroke": "#dddddd",
					"strokeWidth": 1
				},
				"displayLabel": {
					"type": "text",
					"top": 602,
					"left": 226,
					"width": 96,
					"height": 28,
					"text": "Display",
					"fontSize": 16,
					"textAlign": "right"
				},
				"lineNumbersCheckbox": {
					"type": "checkbox",
					"top": 602,
					"left": 336,
					"width": 280,
					"height": 24,
					"text": "Show Line Numbers",
					"textPlacement": "right",
					"fontSize": 16,
					"dataSource": "Form.showLineNumbers",
					"dataSourceTypeHint": "boolean"
				},
				"previewCheckbox": {
					"type": "checkbox",
					"top": 640,
					"left": 336,
					"width": 220,
					"height": 24,
					"text": "Show Preview",
					"textPlacement": "right",
					"fontSize": 16,
					"dataSource": "Form.showPreview",
					"dataSourceTypeHint": "boolean"
				}
			}
		}
	]
}
